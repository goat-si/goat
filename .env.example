# Optional: GOAT Connect source builds
# GOAT Connect has no production deployment yet, so these stay commented out and
# builds have cloud features disabled. To test against your own Clerk instance and
# relay, uncomment them and fill in the public identifiers from the Clerk Dashboard
# (API keys, JWT templates, and OAuth applications).
# Do not add server-side secrets to this file.

# GOAT_CLERK_PUBLISHABLE_KEY=pk_test_<your-key>
# GOAT_CLERK_JWT_TEMPLATE=goat-relay
# GOAT_CLERK_CLI_OAUTH_CLIENT_ID=<your-oauth-client-id>

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in GOAT_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# GOAT_APPLE_TEAM_ID=ABC1234567
# GOAT_MACOS_PROVISIONING_PROFILE=/absolute/path/to/goat.provisionprofile
# GOAT_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Relay origin. For a self-hosted relay, `infra/relay` deploys update it
# automatically.
# GOAT_RELAY_URL=https://relay.example.com

# Hosted web app origin for the CLI's GOAT Connect sign-in. GOAT has no hosted app,
# so CLI sign-in needs this set to your own deployment.
# GOAT_HOSTED_APP_URL=https://app.example.com

# Public, ingest-only mobile OpenTelemetry configuration.
# GOAT_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# GOAT_MOBILE_OTLP_TRACES_DATASET=goat-mobile-traces-dev
# GOAT_MOBILE_OTLP_TRACES_TOKEN=xaat-...
