# Optional: public Connect identifiers from upstream's production deployment.
# GOAT Connect is off in every build, so copying this file to .env enables nothing yet.
# These public identifiers are not secrets. They remain for upstream compatibility;
# GOAT does not use them to enable cloud features.
# Do not add server-side secrets to this file.

# Production Clerk instance. To use your own, get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications.
GOAT_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
GOAT_CLERK_JWT_TEMPLATE=goat-relay
GOAT_CLERK_CLI_OAUTH_CLIENT_ID=hzxSgY2cH10sDU2r

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in GOAT_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# GOAT_APPLE_TEAM_ID=ABC1234567
# GOAT_MACOS_PROVISIONING_PROFILE=/absolute/path/to/goat.provisionprofile
# GOAT_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Production relay. For a self-hosted relay, `infra/relay` deploys update it
# automatically.
GOAT_RELAY_URL=https://relay.t3.codes

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.t3.codes; override to test against a staging deployment.
# GOAT_HOSTED_APP_URL=https://nightly.app.t3.codes

# Public, ingest-only mobile OpenTelemetry configuration.
# GOAT_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# GOAT_MOBILE_OTLP_TRACES_DATASET=goat-mobile-traces-dev
# GOAT_MOBILE_OTLP_TRACES_TOKEN=xaat-...
