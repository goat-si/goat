{
  "description": "Atomic rules of design 014 section 10.2 (HTTP/1.1 client side), written before the parser. Each id is one condition; '+' ids are accepting boundaries. 'error' is the PenError code a refusal carries; 'where' names what enforces it: the response parser (cases in http1-malformed.json) or the fetch adapter (a test titled with the id in penFetch.test.ts).",
  "rules": [
    {
      "id": "H01a",
      "accepts": true,
      "text": "status line of 1,024 bytes accepted",
      "where": "parser",
      "error": null
    },
    {
      "id": "H01b",
      "accepts": false,
      "text": "status line of 1,025 bytes",
      "where": "parser",
      "error": "http1/H01"
    },
    {
      "id": "H02a",
      "accepts": false,
      "text": "version other than HTTP/1.1",
      "where": "parser",
      "error": "http1/H02"
    },
    {
      "id": "H02b",
      "accepts": false,
      "text": "missing SP after the version",
      "where": "parser",
      "error": "http1/H02"
    },
    {
      "id": "H02c",
      "accepts": false,
      "text": "status code not exactly three digits",
      "where": "parser",
      "error": "http1/H02"
    },
    {
      "id": "H02d",
      "accepts": false,
      "text": "missing SP after the status code",
      "where": "parser",
      "error": "http1/H02"
    },
    {
      "id": "H02e",
      "accepts": false,
      "text": "control character in the reason",
      "where": "parser",
      "error": "http1/H02"
    },
    {
      "id": "H02f",
      "accepts": true,
      "text": "empty reason after SP accepted",
      "where": "parser",
      "error": null
    },
    {
      "id": "H03a",
      "accepts": false,
      "text": "status 199",
      "where": "parser",
      "error": "http1/H05"
    },
