      "where": "parser",
      "error": "http1/H03"
    },
    {
      "id": "H03c",
      "accepts": true,
      "text": "statuses 200 and 599 accepted",
      "where": "parser",
      "error": null
    },
    {
      "id": "H04",
      "accepts": false,
