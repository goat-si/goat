      "error": null,
      "closeCode": null
    },
    {
      "id": "W21",
      "accepts": true,
      "text": "an unsolicited pong is ignored",
      "where": "decoder",
      "error": null,
      "closeCode": null
    },
    {
      "id": "W22",
      "accepts": true,
      "text": "inbound holds at most one message",
      "where": "adapter",
      "error": null,
      "closeCode": null
    },
    {
      "id": "W23",
      "accepts": true,
      "text": "the reader pulls, so stream credit is the backpressure",
      "where": "adapter",
      "error": null,
      "closeCode": null
    },
    {
      "id": "W24",
      "accepts": true,
      "text": "101 and the first frame in one chunk",
      "where": "adapter",
      "error": null,
      "closeCode": null
