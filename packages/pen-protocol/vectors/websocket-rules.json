    {
      "id": "W08b",
      "accepts": false,
      "text": "control payload of 126 bytes",
      "where": "decoder",
      "error": "ws/W08",
      "closeCode": 1002
    },
    {
      "id": "W09",
      "accepts": false,
      "text": "fragmented control frame",
      "where": "decoder",
      "error": "ws/W09",
      "closeCode": 1002
    },
    {
      "id": "W10",
      "accepts": true,
      "text": "control frames between fragments accepted",
      "where": "decoder",
      "error": null,
      "closeCode": null
