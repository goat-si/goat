{
  "description": "Atomic rules of design 014 section 10.2 (WebSocket client side), written before the decoder. 'where': decoder (cases in websocket-malformed.json) or the WebSocket adapter (a test titled with the id in websocket.test.ts or penWebSocket.test.ts).",
  "rules": [
    {
      "id": "W01",
      "accepts": true,
      "text": "outbound frames are masked",
      "where": "adapter",
      "error": null,
      "closeCode": null
    },
    {
      "id": "W02a",
      "accepts": true,
      "text": "a fresh CSPRNG mask per frame",
      "where": "adapter",
      "error": null,
      "closeCode": null
    },
    {
      "id": "W02b",
      "accepts": false,
      "text": "a Random failure sends nothing",
      "where": "adapter",
      "error": "random-unavailable",
      "closeCode": null
    },
    {
      "id": "W03",
      "accepts": false,
      "text": "a masked inbound frame",
      "where": "decoder",
      "error": "ws/W03",
      "closeCode": 1002
    },
    {
      "id": "W04a",
      "accepts": false,
      "text": "RSV1 set",
      "where": "decoder",
      "error": "ws/W04",
      "closeCode": 1002
    },
    {
      "id": "W04b",
      "accepts": false,
      "text": "RSV2 set",
      "where": "decoder",
      "error": "ws/W04",
      "closeCode": 1002
    },
    {
      "id": "W04c",
      "accepts": false,
      "text": "RSV3 set",
      "where": "decoder",
      "error": "ws/W04",
      "closeCode": 1002
