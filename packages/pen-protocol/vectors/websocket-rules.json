      "error": "ws/W15",
      "closeCode": 1007
    },
    {
      "id": "W16a",
      "accepts": true,
      "text": "close codes 1000-1003, 1007-1011, 3000 and 4999 accepted",
      "where": "decoder",
      "error": null,
      "closeCode": null
    },
    {
      "id": "W16b",
      "accepts": false,
      "text": "close codes 999, 1004, 1005, 1006, 1012, 2999, 5000",
