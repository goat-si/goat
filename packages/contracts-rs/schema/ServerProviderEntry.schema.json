          "type": [
            "string",
            "null"
          ]
        },
        "methods": {
          "items": {
            "$ref": "#/$defs/ProviderAuthMethod"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "phase": {
          "$ref": "#/$defs/ProviderAuthPhase"
        }
