      "enum": [
        "agent",
        "terminal",
        "credentials"
      ],
      "type": "string"
    },
    "ProviderAuthPhase": {
      "enum": [
        "idle",
        "starting",
        "waiting",
        "verifying",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "ProviderAuthState": {
      "properties": {
        "authorizationUrl": {
          "type": [
            "string",
