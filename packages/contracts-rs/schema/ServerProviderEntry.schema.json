        "executablePath": {
          "type": [
            "string",
            "null"
          ]
        },
        "installedVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "operationId": {
          "type": [
            "string",
            "null"
          ]
        },
