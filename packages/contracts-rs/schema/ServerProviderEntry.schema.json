{
  "$defs": {
    "AcpRegistryUrlAuthAction": {
      "description": "v1 `AcpRegistryUrlAuthAction` (`acpRegistry.ts`): the sign-in URL an ACP registry agent asked the\nperson to open, answered by its elicitation id.\n\nv1's length checks on these strings are not carried: the registry driver bounds what it reads,\nand serde and the JSON Schema accept the same values.",
      "properties": {
        "createdAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "elicitationId": {
          "type": "string"
        },
        "expiresAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "elicitationId",
        "url",
        "message"
      ],
      "type": "object"
    },
    "ApprovalCapabilities": {
      "description": "v1 `OrchestrationV2ApprovalCapabilities`.",
      "properties": {
        "approvalCallbacksAreLiveOnly": {
          "type": "boolean"
        },
        "approvalsCanOriginateFromSubagents": {
          "type": "boolean"
        },
        "approvalsHaveNativeRequestIds": {
          "type": "boolean"
        },
        "supportsApplyPatchApproval": {
          "type": "boolean"
        },
        "supportsCommandApproval": {
          "type": "boolean"
        },
        "supportsFileChangeApproval": {
          "type": "boolean"
        },
        "supportsFileReadApproval": {
          "type": "boolean"
        }
      },
      "required": [
        "supportsCommandApproval",
        "supportsFileReadApproval",
        "supportsFileChangeApproval",
        "supportsApplyPatchApproval",
        "approvalsHaveNativeRequestIds",
        "approvalCallbacksAreLiveOnly",
        "approvalsCanOriginateFromSubagents"
      ],
      "type": "object"
    },
    "CheckpointCapabilities": {
      "description": "v1 `OrchestrationV2CheckpointCapabilities`.",
      "properties": {
        "appCanCheckpointFilesystem": {
          "type": "boolean"
        },
        "providerCanReadConversationSnapshot": {
          "type": "boolean"
        },
        "providerCanRollbackConversation": {
          "type": "boolean"
        },
        "providerRollbackReturnsSnapshot": {
          "type": "boolean"
        },
        "supportsNestedCheckpointScopes": {
          "type": "boolean"
        }
      },
      "required": [
        "appCanCheckpointFilesystem",
        "supportsNestedCheckpointScopes",
        "providerCanRollbackConversation",
        "providerRollbackReturnsSnapshot",
        "providerCanReadConversationSnapshot"
      ],
      "type": "object"
    },
    "CloudSourceRestriction": {
      "description": "v1 `OrchestrationV2CloudSourceRestriction`.",
      "enum": [
        "published-ref",
        "clean-pushed-sha",
        "project-folder"
      ],
      "type": "string"
    },
    "ContextCapabilities": {
      "description": "v1 `OrchestrationV2ContextCapabilities`.",
      "properties": {
        "acceptsDeveloperContext": {
          "type": "boolean"
        },
        "acceptsSyntheticUserContext": {
          "type": "boolean"
        },
        "acceptsSystemContext": {
          "type": "boolean"
        },
        "canConsumeHandoffSummaries": {
          "type": "boolean"
        },
        "canGenerateSummaries": {
          "type": "boolean"
        },
        "maxRecommendedHandoffChars": {
          "description": "v1 `NullOr(PositiveInt)`: zero is rejected.",
          "format": "uint32",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "supportsDeltaHandoff": {
          "type": "boolean"
        },
        "supportsFullThreadHandoff": {
          "type": "boolean"
        }
      },
      "required": [
        "acceptsSystemContext",
        "acceptsDeveloperContext",
        "acceptsSyntheticUserContext",
        "canGenerateSummaries",
        "canConsumeHandoffSummaries",
        "supportsDeltaHandoff",
        "supportsFullThreadHandoff"
      ],
      "type": "object"
    },
    "CredentialOwner": {
      "enum": [
        "provider",
        "t3"
      ],
      "type": "string"
    },
    "ExecutionLocation": {
      "description": "v1 session `executionLocation`.",
      "enum": [
        "local",
        "cloud"
      ],
      "type": "string"
    },
    "FollowUpSupport": {
      "description": "v1 session `followUp`.",
      "properties": {
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "supported": {
          "type": "boolean"
        }
      },
      "required": [
        "supported"
      ],
      "type": "object"
    },
    "IdentityCapabilities": {
      "description": "v1 `OrchestrationV2IdentityCapabilities`.",
      "properties": {
        "nativeItemIds": {
          "$ref": "#/$defs/NativeRefStrength"
        },
        "nativeRequestIds": {
          "$ref": "#/$defs/NativeRefStrength"
        },
        "nativeThreadIds": {
          "$ref": "#/$defs/NativeRefStrength"
        },
        "nativeTurnIds": {
          "$ref": "#/$defs/NativeRefStrength"
        }
      },
      "required": [
        "nativeThreadIds",
        "nativeTurnIds",
        "nativeItemIds",
        "nativeRequestIds"
      ],
      "type": "object"
    },
    "MemoryCapabilities": {
      "description": "v1 `MemoryProviderCapabilities`.",
      "properties": {
        "generateMemorySummary": {
          "type": "boolean"
        },
        "mcp": {
          "type": "boolean"
        },
        "resolveMemoryConflict": {
          "type": "boolean"
        },
        "snapshot": {
          "type": "boolean"
        }
      },
      "required": [
        "snapshot",
        "mcp",
        "resolveMemoryConflict",
        "generateMemorySummary"
      ],
      "type": "object"
    },
    "ModelBadge": {
      "description": "v1 model `badge`.",
      "enum": [
        "new"
      ],
      "type": "string"
    },
    "ModelCapabilities": {
      "description": "v1 `ModelCapabilities`.",
      "properties": {
        "optionDescriptors": {
          "items": {
            "$ref": "#/$defs/ProviderOptionDescriptor"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "NativeRefStrength": {
      "description": "v1 `OrchestrationV2NativeRefStrength`.",
      "enum": [
        "strong",
        "weak",
        "none"
      ],
      "type": "string"
    },
    "PlanningCapabilities": {
      "description": "v1 `OrchestrationV2PlanningCapabilities`.",
      "properties": {
        "emitsPlanUpdated": {
          "type": "boolean"
        },
        "emitsProposedPlan": {
          "type": "boolean"
        },
        "emitsTodoList": {
          "type": "boolean"
        },
        "planDeltasHaveItemIds": {
          "type": "boolean"
        },
        "supportsStructuredQuestions": {
          "type": "boolean"
        }
      },
      "required": [
        "emitsPlanUpdated",
        "emitsTodoList",
        "emitsProposedPlan",
        "supportsStructuredQuestions",
        "planDeltasHaveItemIds"
      ],
      "type": "object"
    },
    "ProviderAuthInteraction": {
      "oneOf": [
        {
          "properties": {
            "acceptsCallback": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "id": {
              "type": "string"
            },
            "requiresConsent": {
              "type": "boolean"
            },
            "type": {
              "const": "browser",
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "url",
            "requiresConsent"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "const": "deviceCode",
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "userCode": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "url",
            "userCode"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "type": "string"
            },
            "output": {
              "type": "string"
            },
            "outputOffset": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "type": {
              "const": "terminal",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "output"
          ],
          "type": "object"
        },
        {
          "properties": {
            "fields": {
              "items": {
                "$ref": "#/$defs/ProviderCredentialField"
              },
              "type": "array"
            },
            "id": {
              "type": "string"
            },
            "type": {
              "const": "credentials",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "fields"
          ],
          "type": "object"
        }
      ]
    },
    "ProviderAuthMethod": {
      "properties": {
        "accountEmail": {
          "type": [
            "string",
            "null"
          ]
        },
        "canRemove": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
