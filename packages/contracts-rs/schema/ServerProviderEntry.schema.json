          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "driver",
        "phase",
        "downloadedBytes",
        "canRemove"
      ],
