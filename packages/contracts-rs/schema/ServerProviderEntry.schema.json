    "ProviderInstanceId": {
      "description": "A configured provider instance (v1 `ProviderInstanceId`), e.g. `codex`.",
      "type": "string"
    },
    "ProviderOptionChoice": {
      "description": "v1 `ProviderOptionChoice`.",
