{
  "$defs": {
    "BotId": {
      "description": "A bot. Each bot owns one `bot` thread.",
      "type": "string"
    },
    "ChildCounts": {
      "description": "Child counts for a parent card.",
      "properties": {
        "running": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "running",
        "total"
      ],
      "type": "object"
    },
    "EngineConfig": {
      "description": "Engine settings for a thread, with v1 `OrchestrationV2AppThread` field names.",
      "properties": {
        "cwd": {
          "type": "string"
        },
        "modelSelection": {
          "$ref": "#/$defs/ModelSelection"
        },
        "providerInstanceId": {
          "$ref": "#/$defs/ProviderInstanceId"
        },
        "runtimeMode": {
          "$ref": "#/$defs/RuntimeMode"
        }
      },
      "required": [
        "providerInstanceId",
        "modelSelection",
        "runtimeMode",
        "cwd"
      ],
      "type": "object"
    },
    "EngineDriver": {
      "description": "The provider behind an engine, as v1 `ProviderDriverKind` values (goat\n`apps/web/src/components/settings/providerDriverMeta.ts`). It names the provider, not the\ntransport, so moving a provider between driver crates never changes persisted lines. Registry\nagents are `acpRegistry` plus the agent id. Cloud kinds are Part 3.\n\nWire: `\"codex\"`, `\"claudeAgent\"`, `\"grok\"`, ..., `{\"acpRegistry\": {\"agentId\": \"kimi\"}}`.",
      "oneOf": [
        {
          "enum": [
            "codex",
            "claudeAgent",
            "grok",
            "fx",
            "antigravity",
            "opencode",
            "cursor",
            "muse",
            "pi",
            "omo"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "acpRegistry": {
              "properties": {
                "agentId": {
                  "type": "string"
                }
              },
              "required": [
                "agentId"
              ],
              "type": "object"
            }
          },
          "required": [
            "acpRegistry"
          ],
          "type": "object"
        }
      ]
    },
    "EngineRef": {
      "description": "Last seen engine session pointer (Codex threadId). Not the thread's identity.",
      "properties": {
        "driver": {
          "$ref": "#/$defs/EngineDriver"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "driver",
        "id"
      ],
      "type": "object"
    },
    "Epoch": {
      "description": "Generation of a `goat.jsonl` file or of the card index. A UUID string.",
      "type": "string"
    },
    "FollowUpMode": {
      "description": "How a message sent while a run is active is handled by default.",
      "oneOf": [
        {
          "const": "steer",
          "description": "Mix into the current run at the next tool/model boundary (human and worker threads).",
          "type": "string"
        },
        {
          "const": "followup",
          "description": "Start a new run after the current one, one by one (bot threads).",
          "type": "string"
        },
        {
          "const": "collect",
          "description": "Merge inputs that arrive within [crate::limits::COLLECT_WINDOW_MS] into the next run.",
          "type": "string"
        }
      ]
    },
    "ItemId": {
      "description": "A finished item inside a run (TurnItem id).",
      "type": "string"
    },
    "ModelSelection": {
      "description": "v1 `ModelSelection`: provider instance, model and model options.",
      "properties": {
        "instanceId": {
          "$ref": "#/$defs/ProviderInstanceId"
        },
        "model": {
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/ProviderOptionSelection"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "instanceId",
        "model"
      ],
      "type": "object"
    },
    "NeedsYou": {
      "description": "The open human request summarised on the card.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/RequestKind"
        },
        "summary": {
          "description": "At most [NEEDS_YOU_SUMMARY_MAX_CHARS] characters.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "summary"
      ],
      "type": "object"
    },
    "ParentRef": {
      "description": "Parent link, written on the child (`parent: {threadId, byItemId}`).",
      "properties": {
        "byItemId": {
          "$ref": "#/$defs/ItemId",
          "description": "The parent's tool-call item that started this child."
        },
        "threadId": {
          "$ref": "#/$defs/ThreadId"
        }
      },
      "required": [
        "threadId",
        "byItemId"
      ],
      "type": "object"
    },
    "ProjectId": {
      "description": "A project the thread belongs to (card index column).",
      "type": "string"
    },
    "ProviderInstanceId": {
      "description": "A configured provider instance (v1 `ProviderInstanceId`), e.g. `codex`.",
      "type": "string"
    },
    "ProviderOptionSelection": {
      "description": "v1 `ProviderOptionSelection`, e.g. `{id: \"reasoningEffort\", value: \"xhigh\"}`.",
      "properties": {
        "id": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/ProviderOptionSelectionValue"
        }
      },
      "required": [
        "id",
        "value"
      ],
      "type": "object"
    },
    "ProviderOptionSelectionValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        }
      ],
      "description": "v1 `ProviderOptionSelectionValue`: a trimmed string or a boolean."
    },
    "RequestKind": {
      "description": "What kind of human step a request needs.",
      "oneOf": [
        {
          "enum": [
            "approval",
            "question",
            "signin"
          ],
          "type": "string"
        },
        {
          "const": "resend",
          "description": "A run settled as `unknown` waits for a person to choose resend or drop.",
          "type": "string"
        },
        {
          "const": "decision",
          "description": "A choice among options (v1 `goat_decision_request`). Silence never approves.",
          "type": "string"
        }
      ]
    },
    "RuntimeMode": {
      "description": "v1 `RuntimeMode` (`providerPolicy.ts`).",
      "enum": [
        "approval-required",
        "auto-accept-edits",
        "auto",
        "full-access"
      ],
      "type": "string"
    },
    "ThreadId": {
      "description": "A GOAT thread. Also the folder name under `~/.goat2/threads/`.",
      "type": "string"
    },
    "ThreadKind": {
      "description": "Who created the thread.",
      "oneOf": [
        {
          "const": "bot",
          "description": "One per bot, forever.",
          "type": "string"
        },
        {
          "const": "worker",
          "description": "Started by a parent thread through MCP `thread.start`.",
          "type": "string"
        },
        {
          "const": "user",
          "description": "Started by a person.",
          "type": "string"
        }
      ]
    },
    "ThreadStatus": {
      "description": "Card status shown in lists and the inbox.",
      "enum": [
        "idle",
        "queued",
        "running",
        "needs_you",
        "failed"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One row per thread. Every text field is bounded.",
  "properties": {
    "appliedSeq": {
      "description": "Last `goat.jsonl` seq folded into this card, at most [crate::limits::MAX_SAFE_WIRE_INTEGER].",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "archivedAt": {
      "description": "v1 `archivedAt`: when the thread was archived (`thread.changed {archivedAt}`), else `null`.\nArchived cards stay in the index.",
      "type": [
        "string",
        "null"
      ]
    },
    "botId": {
      "anyOf": [
        {
          "$ref": "#/$defs/BotId"
        },
        {
          "type": "null"
        }
      ]
    },
    "cardSeq": {
      "description": "Card index global sequence, the `subscribeCards` cursor, at most\n[crate::limits::MAX_SAFE_WIRE_INTEGER].",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "children": {
      "$ref": "#/$defs/ChildCounts"
    },
    "engine": {
      "$ref": "#/$defs/EngineConfig"
    },
    "engineRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/EngineRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "epoch": {
      "$ref": "#/$defs/Epoch",
      "description": "Generation of this thread's `goat.jsonl`."
    },
    "followUpMode": {
      "$ref": "#/$defs/FollowUpMode"
    },
    "id": {
      "$ref": "#/$defs/ThreadId"
    },
    "kind": {
      "$ref": "#/$defs/ThreadKind"
    },
    "latestAnswerExcerpt": {
      "description": "Start of the last answer, at most [CARD_EXCERPT_MAX_CHARS] characters (v1\n`latestAnswerExcerpt`).",
      "type": "string"
    },
    "needsYou": {
      "anyOf": [
        {
          "$ref": "#/$defs/NeedsYou"
        },
        {
          "type": "null"
        }
      ]
    },
    "openAsks": {
      "format": "uint32",
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "parent": {
      "anyOf": [
        {
          "$ref": "#/$defs/ParentRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "projectId": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectId"
        },
        {
          "type": "null"
        }
      ],
      "description": "Card index column for lookups by project."
    },
    "status": {
      "$ref": "#/$defs/ThreadStatus"
    },
    "title": {
      "description": "At most [CARD_TITLE_MAX_CHARS] characters.",
      "type": "string"
    },
    "unread": {
      "type": "boolean"
    },
    "updatedAt": {
      "description": "RFC 3339 UTC timestamp.",
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind",
    "title",
    "engine",
    "status",
    "latestAnswerExcerpt",
    "children",
    "followUpMode",
    "updatedAt",
    "epoch",
    "appliedSeq",
    "cardSeq"
  ],
  "title": "ThreadCard",
  "type": "object"
}
