{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "v1 `DecisionEscalateInput` (MCP `decision.escalate`): only the asking thread's parent.",
  "properties": {
    "id": {
      "type": "string"
    },
    "reason": {
      "description": "1 to 2000 characters, not blank.",
      "maxLength": 2000,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    }
  },
  "required": [
    "id",
    "reason"
  ],
  "title": "DecisionEscalateInput",
  "type": "object"
}
