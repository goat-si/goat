{
  "$defs": {
    "BotFace": {
      "description": "A bot's face, drawn by `packages/bot-face`.",
      "properties": {
        "color": {
          "type": "string"
        },
        "goat": {
          "description": "The GOAT mark instead of a generated face.",
          "type": "boolean"
        },
        "shape": {
          "type": "string"
        }
      },
      "required": [
        "shape",
        "color",
        "goat"
      ],
      "type": "object"
    },
    "BotId": {
      "description": "A bot. Each bot owns one `bot` thread.",
      "type": "string"
    },
    "BotRole": {
      "description": "`main` is the GOAT bot; every other bot is a `member`.",
      "enum": [
        "main",
        "member"
      ],
      "type": "string"
    },
    "ModelSelection": {
      "description": "v1 `ModelSelection`: provider instance, model and model options.",
      "properties": {
        "instanceId": {
          "$ref": "#/$defs/ProviderInstanceId"
        },
        "model": {
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/ProviderOptionSelection"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "instanceId",
        "model"
      ],
      "type": "object"
    },
    "ProviderInstanceId": {
      "description": "A configured provider instance (v1 `ProviderInstanceId`), e.g. `codex`.",
      "type": "string"
    },
    "ProviderOptionSelection": {
      "description": "v1 `ProviderOptionSelection`, e.g. `{id: \"reasoningEffort\", value: \"xhigh\"}`.",
      "properties": {
        "id": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/ProviderOptionSelectionValue"
        }
      },
      "required": [
        "id",
        "value"
      ],
      "type": "object"
    },
    "ProviderOptionSelectionValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        }
      ],
      "description": "v1 `ProviderOptionSelectionValue`: a trimmed string or a boolean."
    },
    "ThreadId": {
      "description": "A GOAT thread. Also the folder name under `~/.goat2/threads/`.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`bots/<botId>.json` and the `bot_changed` payload.",
  "properties": {
    "botId": {
      "$ref": "#/$defs/BotId"
    },
    "defaultModelSelection": {
      "$ref": "#/$defs/ModelSelection",
      "description": "v1 `defaultModelSelection`."
    },
    "face": {
      "$ref": "#/$defs/BotFace"
    },
    "instructions": {
      "description": "v1 `BotInstructions`: at most 16384 characters and UTF-8 bytes (bytes checked by serde only).",
      "maxLength": 16384,
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/BotRole"
    },
    "sessionThreadId": {
      "$ref": "#/$defs/ThreadId",
      "description": "The bot's own `bot` thread (v1 `sessionThreadId`)."
    }
  },
  "required": [
    "botId",
    "name",
    "purpose",
    "face",
    "role",
    "sessionThreadId",
    "defaultModelSelection"
  ],
  "title": "BotProfile",
  "type": "object"
}
