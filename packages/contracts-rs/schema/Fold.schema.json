  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Fold state beyond the card: what a reader (or the store after a crash) needs to continue\nfolding from a checkpoint without reading earlier lines.\n\nFold rules (lane A store): `input.accepted` queues; `input.delivered` accepted leaves the\nqueue, declined stays queued and leaves `activeRunInputIds`, unknown moves into the active\nrun's hold. At `run.finished`, run inputs still queued are delivered if\n`activeRunReachedEngine`, held if the outcome is `unknown`, else stay queued; an `unknown`\noutcome opens request `resend:<runId>` (kind `resend`) holding them.\n\nSteers: `input.delivered {as: steer, outcome: accepted}` moves the input from\n`queuedInputs` to `steeredInputs`. A later `{as: steer, outcome: declined}` for an input in\n`steeredInputs` (the engine dropped an accepted steer, `EngineEvent::SteerUpdated` Cancelled)\nmoves it back to the END of `queuedInputs` with mode `followup`, same inputId, text, source\nand attachments (v1 re-dispatches through the normal queue). A declined steer still queued is\nunchanged. `steeredInputs` is cleared at the next `run.started`, so a cancel that arrives as\nthe turn ends still requeues.",
  "properties": {
    "activeRunId": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunId"
        },
        {
          "type": "null"
        }
      ],
      "description": "The run between `run.started` and `run.finished`, if any."
    },
    "activeRunInputIds": {
      "description": "Inputs carried by the active run's `run.started`.",
      "items": {
        "$ref": "#/$defs/InputId"
      },
      "type": "array"
    },
    "activeRunReachedEngine": {
      "description": "True once `run.accepted`, an `item.completed` or `request.opened` for the active run, or\n`input.delivered {as: turn, outcome: accepted}` for one of its inputs is folded (steer\ndeliveries do not count). Restart settlement: true -> `interrupted`, false -> `unknown`.",
      "type": "boolean"
    },
    "counters": {
      "$ref": "#/$defs/FoldCounters"
    },
    "heldInputs": {
      "description": "Inputs whose delivery is ambiguous, held by a resend request (one hold per run).",
      "items": {
        "$ref": "#/$defs/HeldInputs"
      },
      "type": "array"
    },
    "lastRunOutcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunOutcome"
        },
        {
          "type": "null"
        }
      ],
      "description": "Outcome of the last finished run, for the `failed` status after later events."
    },
    "openRequests": {
      "description": "Requests still open (including `resend`), so the inbox renders without earlier lines.",
      "items": {
        "$ref": "#/$defs/RequestOpened"
      },
      "type": "array"
    },
    "queuedInputs": {
      "description": "Inputs accepted but not yet delivered, in order, with `input.changed` edits applied, so a\nclient gets the whole queue from a checkpoint.",
      "items": {
        "$ref": "#/$defs/QueuedInput"
      },
      "type": "array"
    },
    "runningChildIds": {
      "description": "Children started and not yet reported; `card.children.running` is its length.",
      "items": {
        "$ref": "#/$defs/ThreadId"
      },
      "type": "array"
    },
    "steeredInputs": {
      "description": "Steers the engine accepted that are not settled yet (see the steer rules above). Omitted\nwhen empty; checkpoints written before this field read as empty.",
      "items": {
        "$ref": "#/$defs/QueuedInput"
      },
      "type": "array"
    }
  },
  "required": [
    "activeRunInputIds",
    "activeRunReachedEngine",
    "queuedInputs",
    "heldInputs",
    "openRequests",
    "runningChildIds",
    "counters"
  ],
  "title": "Fold",
  "type": "object"
}
