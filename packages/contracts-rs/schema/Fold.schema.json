{
  "$defs": {
    "Actor": {
      "description": "v1 `OrchestrationV2Actor`.",
      "enum": [
        "user",
        "agent",
        "system"
      ],
      "type": "string"
    },
    "ApprovalDecision": {
      "description": "v1 `ProviderApprovalDecision`.",
      "enum": [
        "accept",
        "acceptForSession",
        "acceptAlways",
        "decline",
        "cancel"
      ],
      "type": "string"
    },
    "ApprovalOption": {
      "description": "v1 `ProviderApprovalOption`.",
      "properties": {
        "decision": {
          "$ref": "#/$defs/ApprovalDecision"
        },
        "label": {
          "type": "string"
        },
        "warning": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "decision",
        "label"
      ],
      "type": "object"
    },
    "AssistantDelivery": {
      "description": "v1 assistant `delivery: \"async\"`: sent mid-turn, apart from the turn's answer.",
      "enum": [
        "async"
      ],
      "type": "string"
    },
    "AssistantMessagePhase": {
      "description": "v1 `AssistantMessagePhase`.",
      "enum": [
        "commentary",
        "partial_answer",
        "final_answer"
      ],
      "type": "string"
    },
    "BlobRef": {
      "description": "Where a large body or attachment lives inside the thread folder.",
      "properties": {
        "path": {
          "description": "Path relative to the thread folder, e.g. `blobs/<itemId>.txt`.",
          "type": "string"
        },
        "sizeBytes": {
          "description": "Full size in bytes.",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sizeBytes"
      ],
      "type": "object"
    },
    "ChatAttachment": {
      "description": "v1 `ChatImageAttachment` / `ChatFileAttachment`, plus where the bytes live.",
      "properties": {
        "blob": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sizeBytes": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "$ref": "#/$defs/ChatAttachmentType"
        }
      },
      "required": [
        "type",
        "id",
        "name",
        "mimeType",
        "sizeBytes"
      ],
      "type": "object"
    },
    "ChatAttachmentType": {
      "description": "v1 `ChatAttachment` kinds Part 1 accepts.",
      "enum": [
        "image",
        "file"
      ],
      "type": "string"
    },
    "CommandAction": {
      "description": "v1 `OrchestrationV2CommandAction`: what a read-only shell command does.",
      "oneOf": [
        {
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "const": "read",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
          ],
          "type": "object"
        },
        {
          "properties": {
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "list",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "query": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "search",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "CreationSource": {
      "description": "v1 `OrchestrationV2CreationSource`.",
      "enum": [
        "web",
        "mobile",
        "mcp",
        "provider",
        "server"
      ],
      "type": "string"
    },
    "DecisionOption": {
      "description": "One choice of a `decision` request.",
      "properties": {
        "consequence": {
          "description": "v1 `DecisionOption.consequence` (required).",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "consequence"
      ],
      "type": "object"
    },
    "FileChangeDetail": {
      "description": "v1 `OrchestrationV2FileChangeDetail`.",
      "properties": {
        "fileType": {
          "type": [
            "string",
            "null"
          ]
        },
        "mimeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "oldPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "operation": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "operation",
        "path"
      ],
      "type": "object"
    },
    "FoldCounters": {
      "description": "Running totals kept by the fold. Each at most [crate::limits::MAX_SAFE_WIRE_INTEGER].",
      "properties": {
        "inputs": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "items": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "runs": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "inputs",
        "runs",
        "items"
      ],
      "type": "object"
    },
    "HeldInputs": {
      "description": "Inputs held by a `resend` request. `request.resolved` outcome `resend` returns them to the\nfront of `queuedInputs`; `dropped` discards them.",
      "properties": {
        "inputs": {
          "items": {
            "$ref": "#/$defs/QueuedInput"
          },
          "type": "array"
        },
        "requestId": {
          "$ref": "#/$defs/RequestId",
          "description": "`resend:<runId>`."
        },
        "runId": {
          "$ref": "#/$defs/RunId"
        }
      },
      "required": [
        "requestId",
        "runId",
        "inputs"
      ],
      "type": "object"
    },
    "InputId": {
      "description": "An input accepted into a thread's mailbox.",
      "type": "string"
    },
    "InputMode": {
      "description": "How an input is admitted while a run may be active.",
      "oneOf": [
        {
          "enum": [
            "steer",
            "followup",
            "collect"
          ],
          "type": "string"
        },
        {
          "const": "interrupt",
          "description": "Only from the explicit \"stop and send\" button.",
          "type": "string"
        }
      ]
    },
    "InputSource": {
      "description": "Who put an input in the mailbox.",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "user",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "A child's result, after the parent's `child.reported` line.",
          "properties": {
            "kind": {
              "const": "child",
              "type": "string"
            },
            "threadId": {
              "$ref": "#/$defs/ThreadId"
            }
          },
          "required": [
            "kind",
            "threadId"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "system",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "ItemId": {
      "description": "A finished item inside a run (TurnItem id).",
      "type": "string"
    },
    "MessageId": {
      "description": "A chat message id carried by user and assistant TurnItems.",
      "type": "string"
    },
    "NativeItemRef": {
      "description": "v1 `OrchestrationV2ProviderRef`: where the engine keeps this item.",
      "properties": {
        "driver": {
          "type": "string"
        },
        "fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "nativeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "ordinal": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "strength": {
          "$ref": "#/$defs/NativeRefStrength"
        }
      },
      "required": [
        "driver",
        "strength"
      ],
      "type": "object"
    },
    "NativeRefStrength": {
      "description": "v1 `OrchestrationV2NativeRefStrength`.",
      "enum": [
        "strong",
        "weak",
        "none"
      ],
      "type": "string"
    },
    "NoticeSeverity": {
      "description": "v1 `OrchestrationV2NoticeSeverity`.",
      "enum": [
        "info",
        "warning"
      ],
      "type": "string"
    },
    "PlanId": {
      "description": "A plan id carried by plan and todo TurnItems.",
      "type": "string"
    },
    "PlanStep": {
      "description": "v1 `OrchestrationV2PlanStep`.",
      "properties": {
        "durationAnchorAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "durationMs": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PlanStepStatus"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "status"
      ],
      "type": "object"
    },
    "PlanStepStatus": {
      "description": "v1 `OrchestrationV2PlanStep` status.",
      "enum": [
        "pending",
        "running",
        "completed"
      ],
      "type": "string"
    },
    "ProviderFailure": {
      "description": "v1 `OrchestrationV2ProviderFailure`. Producers redact credentials before construction.",
      "properties": {
        "class": {
          "$ref": "#/$defs/ProviderFailureClass"
        },
        "code": {
          "type": [
            "string",
            "null"
          ]
        },
        "log": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "resetAt": {
          "description": "v1 `optional(NullOr(IsoDateTime))`: absent, `null` and a value are distinct.",
          "type": [
            "string",
            "null"
          ]
        },
        "retryable": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "class",
        "message"
      ],
      "type": "object"
    },
    "ProviderFailureClass": {
      "description": "v1 `OrchestrationV2ProviderFailureClass`.",
      "enum": [
        "usage_limit",
        "provider_error",
        "transport_error",
        "permission_error",
        "validation_error",
        "unknown"
      ],
      "type": "string"
    },
    "ProviderRequestKind": {
      "description": "v1 `ProviderRequestKind`.",
      "enum": [
        "command",
        "file-read",
        "file-change",
        "mcp-elicitation",
        "permission"
      ],
      "type": "string"
    },
    "ProviderRetry": {
      "description": "v1 `OrchestrationV2ProviderRetry`.",
      "properties": {
        "attempt": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "maxAttempts": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "retryDelayMs": {
          "default": null,
          "description": "v1 `NullOr`: written as `null` when unknown; a missing field reads as `null`.",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "attempt"
      ],
      "type": "object"
    },
    "QueuedInput": {
      "description": "One queued (or held) input as it stands after `input.changed` edits.",
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/ChatAttachment"
          },
          "type": "array"
        },
        "inputId": {
          "$ref": "#/$defs/InputId"
        },
        "mode": {
          "$ref": "#/$defs/InputMode"
        },
        "source": {
          "$ref": "#/$defs/InputSource"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "inputId",
        "text",
        "mode",
        "source"
      ],
      "type": "object"
    },
    "RequestId": {
      "description": "A human-in-the-loop request (approval, question, sign-in).",
      "type": "string"
    },
    "RequestKind": {
      "description": "What kind of human step a request needs.",
      "oneOf": [
        {
          "enum": [
            "approval",
            "question",
            "signin"
          ],
          "type": "string"
        },
        {
          "const": "resend",
          "description": "A run settled as `unknown` waits for a person to choose resend or drop.",
          "type": "string"
        },
        {
          "const": "decision",
          "description": "A choice among options (v1 `goat_decision_request`). Silence never approves.",
          "type": "string"
        }
      ]
    },
    "RequestOpened": {
      "description": "`request.opened`: a person is needed.",
      "properties": {
        "context": {
          "description": "What the person needs to know to decide (v1 `DecisionItem.context`), at most\n[crate::limits::REQUEST_CONTEXT_MAX_CHARS] characters.",
          "maxLength": 4000,
          "type": [
            "string",
            "null"
          ]
        },
        "item": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnItem"
            },
            {
              "type": "null"
            }
          ],
          "description": "The waiting approval/question item itself, for a request with no run (`runId` null,\nfrom `EngineEvent::SessionRequestOpened`): it cannot be an `item.completed` line, which\nneeds a run, so the request carries its own card, including a question's choices. A request\ninside a run references its item through `itemId` instead and leaves this unset."
        },
        "itemId": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The approval/question item, when the request came from the engine."
        },
        "kind": {
          "$ref": "#/$defs/RequestKind"
        },
        "options": {
          "description": "Kind `decision`: the choices offered (v1 `goat_decision_request`).",
          "items": {
            "$ref": "#/$defs/DecisionOption"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "recommended": {
          "description": "Kind `decision`: the recommended option id. Silence never approves it.",
          "type": [
            "string",
            "null"
          ]
        },
        "requestId": {
          "$ref": "#/$defs/RequestId"
        },
        "runId": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunId"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "description": "At most [crate::limits::NEEDS_YOU_SUMMARY_MAX_CHARS] characters.",
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "kind",
        "summary"
      ],
      "type": "object"
    },
    "RunId": {
      "description": "A run: one batch of inputs sent to the engine until the answer ends.",
      "type": "string"
    },
    "RunOutcome": {
      "description": "How a run ended.",
      "oneOf": [
        {
          "enum": [
            "failed",
            "interrupted"
          ],
          "type": "string"
        },
        {
          "const": "completed",
          "description": "v1 run status `completed`.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "Sent but not known to have reached the engine. Never re-sent automatically.",
          "type": "string"
        }
      ]
    },
    "SubagentOrigin": {
      "description": "v1 subagent `origin`.",
      "enum": [
        "provider_native",
        "app_owned"
      ],
      "type": "string"
    },
    "ThreadId": {
      "description": "A GOAT thread. Also the folder name under `~/.goat2/threads/`.",
      "type": "string"
    },
    "TurnItem": {
      "description": "A finished item, as `item.completed` stores it and the chat renderer draws it.",
      "oneOf": [
        {
          "properties": {
            "attachments": {
              "items": {
                "$ref": "#/$defs/ChatAttachment"
              },
              "type": "array"
            },
            "createdBy": {
              "$ref": "#/$defs/Actor"
            },
            "creationSource": {
              "$ref": "#/$defs/CreationSource"
            },
            "inputIntent": {
              "$ref": "#/$defs/UserMessageInputIntent"
            },
            "messageId": {
              "$ref": "#/$defs/MessageId"
            },
            "senderThreadId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ThreadId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "text": {
              "type": "string"
            },
            "type": {
              "const": "user_message",
              "type": "string"
            }
          },
          "required": [
            "type",
            "createdBy",
            "creationSource",
            "messageId",
            "inputIntent",
            "text",
            "attachments"
          ],
          "type": "object"
        },
        {
          "properties": {
            "attachments": {
              "items": {
                "$ref": "#/$defs/ChatAttachment"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "delivery": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AssistantDelivery"
                },
                {
                  "type": "null"
                }
              ]
            },
            "messageId": {
              "$ref": "#/$defs/MessageId"
            },
            "phase": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AssistantMessagePhase"
                },
                {
                  "type": "null"
                }
              ]
            },
            "streaming": {
              "type": "boolean"
            },
            "text": {
              "type": "string"
            },
            "type": {
              "const": "assistant_message",
              "type": "string"
            }
          },
          "required": [
            "type",
            "messageId",
            "text",
            "streaming"
          ],
          "type": "object"
        },
        {
          "properties": {
            "streaming": {
              "type": "boolean"
            },
            "text": {
              "type": "string"
            },
            "type": {
              "const": "reasoning",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text",
            "streaming"
          ],
          "type": "object"
        },
        {
          "properties": {
            "markdown": {
              "type": "string"
            },
            "planId": {
              "$ref": "#/$defs/PlanId"
            },
            "streaming": {
              "type": "boolean"
            },
            "type": {
              "const": "proposed_plan",
              "type": "string"
            }
          },
          "required": [
            "type",
            "planId",
            "markdown",
            "streaming"
          ],
          "type": "object"
        },
        {
          "properties": {
            "explanation": {
              "type": [
                "string",
                "null"
              ]
            },
            "planId": {
              "$ref": "#/$defs/PlanId"
            },
            "steps": {
              "items": {
                "$ref": "#/$defs/PlanStep"
              },
              "type": "array"
            },
            "type": {
              "const": "todo_list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "planId",
            "steps"
          ],
          "type": "object"
        },
        {
          "properties": {
            "questions": {
              "items": {
                "$ref": "#/$defs/UserInputQuestion"
              },
              "type": "array"
            },
            "requestId": {
              "$ref": "#/$defs/RequestId"
            },
            "type": {
              "const": "user_input_request",
              "type": "string"
            }
          },
          "required": [
            "type",
            "requestId",
            "questions"
          ],
          "type": "object"
        },
        {
          "properties": {
            "options": {
              "items": {
                "$ref": "#/$defs/ApprovalOption"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "prompt": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "requestId": {
              "$ref": "#/$defs/RequestId"
            },
            "requestKind": {
              "$ref": "#/$defs/ProviderRequestKind"
            },
            "type": {
              "const": "approval_request",
              "type": "string"
            }
          },
          "required": [
            "type",
            "requestId",
            "requestKind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "additions": {
              "format": "uint32",
              "maximum": 4294967295,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "changes": {
              "items": {
                "$ref": "#/$defs/FileChangeDetail"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "deletions": {
              "format": "uint32",
              "maximum": 4294967295,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "diffStr": {
              "type": [
                "string",
                "null"
              ]
            },
            "fileName": {
              "type": "string"
            },
            "patch": {
              "description": "This edit alone as a git-style patch. Omitted from the log; read it from the engine.",
              "type": [
                "string",
                "null"
              ]
            },
            "patchOmitted": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "type": {
              "const": "file_change",
              "type": "string"
            }
          },
          "required": [
            "type",
            "fileName"
          ],
          "type": "object"
        },
        {
          "properties": {
            "commandActions": {
              "items": {
