{
  "$defs": {
    "BlobRef": {
      "description": "Where a large body or attachment lives inside the thread folder.",
      "properties": {
        "path": {
          "description": "Path relative to the thread folder, e.g. `blobs/<itemId>.txt`.",
          "type": "string"
        },
        "sizeBytes": {
          "description": "Full size in bytes.",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sizeBytes"
      ],
      "type": "object"
    },
    "BotFace": {
      "description": "A bot's face, drawn by `packages/bot-face`.",
      "properties": {
        "color": {
          "type": "string"
        },
        "goat": {
          "description": "The GOAT mark instead of a generated face.",
          "type": "boolean"
        },
        "shape": {
          "type": "string"
        }
      },
      "required": [
        "shape",
        "color",
        "goat"
      ],
      "type": "object"
    },
    "BotId": {
      "description": "A bot. Each bot owns one `bot` thread.",
      "type": "string"
    },
    "CardCursor": {
      "description": "Position in the card index.",
      "properties": {
        "cardSeq": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "epoch": {
          "$ref": "#/$defs/Epoch"
        }
      },
      "required": [
        "epoch",
        "cardSeq"
      ],
      "type": "object"
    },
    "ChatAttachment": {
      "description": "v1 `ChatImageAttachment` / `ChatFileAttachment`, plus where the bytes live.",
      "properties": {
        "blob": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sizeBytes": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "$ref": "#/$defs/ChatAttachmentType"
        }
      },
      "required": [
        "type",
        "id",
        "name",
        "mimeType",
        "sizeBytes"
      ],
      "type": "object"
    },
    "ChatAttachmentType": {
      "description": "v1 `ChatAttachment` kinds Part 1 accepts.",
      "enum": [
        "image",
        "file"
      ],
      "type": "string"
    },
    "Epoch": {
      "description": "Generation of a `goat.jsonl` file or of the card index. A UUID string.",
      "type": "string"
    },
    "FollowUpMode": {
      "description": "How a message sent while a run is active is handled by default.",
      "oneOf": [
        {
          "const": "steer",
          "description": "Mix into the current run at the next tool/model boundary (human and worker threads).",
          "type": "string"
        },
        {
          "const": "followup",
          "description": "Start a new run after the current one, one by one (bot threads).",
          "type": "string"
        },
        {
          "const": "collect",
          "description": "Merge inputs that arrive within [crate::limits::COLLECT_WINDOW_MS] into the next run.",
          "type": "string"
        }
      ]
    },
    "InputId": {
      "description": "An input accepted into a thread's mailbox.",
      "type": "string"
    },
    "InputMode": {
      "description": "How an input is admitted while a run may be active.",
      "oneOf": [
        {
          "enum": [
            "steer",
            "followup",
            "collect"
          ],
          "type": "string"
        },
        {
          "const": "interrupt",
          "description": "Only from the explicit \"stop and send\" button.",
          "type": "string"
        }
      ]
    },
    "ItemId": {
      "description": "A finished item inside a run (TurnItem id).",
      "type": "string"
    },
    "ModelSelection": {
      "description": "v1 `ModelSelection`: provider instance, model and model options.",
      "properties": {
        "instanceId": {
          "$ref": "#/$defs/ProviderInstanceId"
        },
        "model": {
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/ProviderOptionSelection"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "instanceId",
        "model"
      ],
      "type": "object"
    },
    "ProviderAuthBrowserAction": {
      "enum": [
        "accept",
        "decline"
      ],
      "type": "string"
    },
    "ProviderAuthResponse": {
      "description": "A response may contain credentials or typed secrets. Never log or persist the containing\nframe (including goat.jsonl and tracing).",
      "oneOf": [
        {
          "properties": {
            "action": {
              "$ref": "#/$defs/ProviderAuthBrowserAction"
            },
            "type": {
              "const": "browser",
              "type": "string"
            }
          },
          "required": [
            "type",
            "action"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "maxLength": 4096,
              "type": "string"
            },
            "size": {
              "$ref": "#/$defs/ProviderAuthTerminalSize"
            },
            "type": {
              "const": "terminal",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "credentials",
              "type": "string"
            },
            "values": {
              "additionalProperties": {
                "maxLength": 16384,
                "type": "string"
              },
              "maxProperties": 16,
              "propertyNames": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              "type": "object"
            }
          },
          "required": [
            "type",
            "values"
          ],
          "type": "object"
        }
      ]
    },
    "ProviderAuthTerminalSize": {
      "properties": {
        "cols": {
          "format": "uint16",
          "maximum": 500,
          "minimum": 1,
          "type": "integer"
        },
        "rows": {
          "format": "uint16",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "cols",
        "rows"
      ],
      "type": "object"
    },
    "ProviderInstanceId": {
      "description": "A configured provider instance (v1 `ProviderInstanceId`), e.g. `codex`.",
      "type": "string"
    },
    "ProviderOptionSelection": {
      "description": "v1 `ProviderOptionSelection`, e.g. `{id: \"reasoningEffort\", value: \"xhigh\"}`.",
      "properties": {
        "id": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/ProviderOptionSelectionValue"
        }
      },
      "required": [
        "id",
        "value"
      ],
      "type": "object"
    },
    "ProviderOptionSelectionValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        }
      ],
      "description": "v1 `ProviderOptionSelectionValue`: a trimmed string or a boolean."
    },
    "RequestId": {
      "description": "A human-in-the-loop request (approval, question, sign-in).",
      "type": "string"
    },
    "RequestOutcome": {
      "description": "How a request ended. Approval outcomes are v1 `ProviderApprovalDecision` literals\n(`providerPolicy.ts`); `answered`, `decided`, `resend` and `dropped` are GOAT 2 kinds.",
      "oneOf": [
        {
          "enum": [
            "accept",
            "acceptForSession",
            "acceptAlways",
            "decline",
            "answered"
          ],
          "type": "string"
        },
        {
          "const": "cancel",
          "description": "Approval cancelled, or a question/decision withdrawn.",
          "type": "string"
        },
        {
          "const": "decided",
          "description": "`decision` request: the person picked `optionId`.",
          "type": "string"
        },
        {
          "const": "resend",
          "description": "`resend` request: send the unknown run again.",
          "type": "string"
        },
        {
          "const": "dropped",
          "description": "`resend` request: drop the unknown run.",
          "type": "string"
        }
      ]
    },
    "RuntimeMode": {
      "description": "v1 `RuntimeMode` (`providerPolicy.ts`).",
      "enum": [
        "approval-required",
        "auto-accept-edits",
        "auto",
        "full-access"
      ],
      "type": "string"
    },
    "StartMode": {
      "description": "`start_thread.mode`: whether the starter waits for the thread's result.",
      "enum": [
        "async",
        "wait"
      ],
      "type": "string"
    },
    "ThreadCursor": {
      "description": "Position in one thread's `goat.jsonl`.",
      "properties": {
        "epoch": {
          "$ref": "#/$defs/Epoch"
        },
        "seq": {
          "description": "At most [crate::limits::MAX_SAFE_WIRE_INTEGER].",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "epoch",
        "seq"
      ],
      "type": "object"
    },
    "ThreadId": {
      "description": "A GOAT thread. Also the folder name under `~/.goat2/threads/`.",
      "type": "string"
    },
    "ThreadKind": {
      "description": "Who created the thread.",
      "oneOf": [
        {
          "const": "bot",
          "description": "One per bot, forever.",
          "type": "string"
        },
        {
          "const": "worker",
          "description": "Started by a parent thread through MCP `thread.start`.",
          "type": "string"
        },
        {
          "const": "user",
          "description": "Started by a person.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Frames a client sends: subscriptions, then commands. Every command carries `reqId` (matched by\n`command_result`) and `clientRequestId` (idempotency: the host applies one id once and replays\nits result).",
  "oneOf": [
    {
      "properties": {
        "subId": {
          "type": "string"
        },
        "type": {
          "const": "subscribe_providers",
          "type": "string"
        }
      },
      "required": [
        "type",
        "subId"
      ],
      "type": "object"
    },
    {
      "properties": {
        "botId": {
          "$ref": "#/$defs/BotId"
        },
        "clientRequestId": {
          "type": "string"
        },
        "defaultModelSelection": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelSelection"
            },
            {
              "type": "null"
            }
          ]
        },
        "face": {
          "anyOf": [
            {
              "$ref": "#/$defs/BotFace"
            },
            {
              "type": "null"
            }
          ]
        },
        "instructions": {
          "description": "v1 `BotInstructions`: at most 16384 characters (as `BotProfile.instructions`).",
          "maxLength": 16384,
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ]
        },
        "reqId": {
          "type": "string"
        },
        "type": {
          "const": "update_bot",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reqId",
        "clientRequestId",
        "botId"
      ],
      "type": "object"
    },
    {
      "properties": {
        "botId": {
          "$ref": "#/$defs/BotId"
        },
        "clientRequestId": {
          "type": "string"
        },
        "reqId": {
          "type": "string"
        },
        "type": {
          "const": "list_bot_notes",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reqId",
        "clientRequestId",
        "botId"
      ],
      "type": "object"
    },
    {
      "properties": {
        "botId": {
          "$ref": "#/$defs/BotId"
        },
        "clientRequestId": {
          "type": "string"
        },
        "expectedRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "reqId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "type": {
          "const": "write_bot_notes",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reqId",
        "clientRequestId",
        "botId",
        "text"
      ],
      "type": "object"
    },
    {
      "description": "Records the person's read position: the host keeps `lastReadSeq` per thread in\n`~/.goat2/ui-state.json` (batched writes), never in the thread log. Cards then derive\n`unread` from it.",
      "properties": {
        "clientRequestId": {
          "type": "string"
        },
        "reqId": {
          "type": "string"
        },
        "seq": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "threadId": {
          "$ref": "#/$defs/ThreadId"
        },
        "type": {
          "const": "mark_read",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reqId",
        "clientRequestId",
        "threadId",
        "seq"
      ],
      "type": "object"
    },
    {
      "properties": {
        "clientRequestId": {
          "type": "string"
        },
        "itemId": {
          "$ref": "#/$defs/ItemId"
        },
        "reqId": {
          "type": "string"
        },
        "threadId": {
          "$ref": "#/$defs/ThreadId"
        },
        "type": {
          "const": "get_turn_item",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reqId",
        "clientRequestId",
        "threadId",
        "itemId"
      ],
      "type": "object"
    },
    {
      "properties": {
        "clientRequestId": {
          "type": "string"
        },
        "instanceId": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderInstanceId"
            },
            {
              "type": "null"
            }
          ]
        },
        "refreshModels": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reqId": {
          "type": "string"
        },
        "type": {
          "const": "refresh_providers",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reqId",
        "clientRequestId"
      ],
      "type": "object"
    },
    {
      "properties": {
        "clientRequestId": {
          "type": "string"
        },
        "instanceId": {
          "$ref": "#/$defs/ProviderInstanceId"
        },
        "reqId": {
          "type": "string"
        },
        "type": {
          "const": "provider_install_start",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reqId",
        "clientRequestId",
        "instanceId"
      ],
      "type": "object"
    },
    {
      "properties": {
        "clientRequestId": {
          "type": "string"
        },
        "instanceId": {
          "$ref": "#/$defs/ProviderInstanceId"
        },
        "operationId": {
          "type": "string"
        },
        "reqId": {
          "type": "string"
        },
        "type": {
          "const": "provider_install_cancel",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reqId",
        "clientRequestId",
        "instanceId",
        "operationId"
      ],
      "type": "object"
    },
    {
      "properties": {
        "clientRequestId": {
          "type": "string"
        },
        "instanceId": {
          "$ref": "#/$defs/ProviderInstanceId"
        },
        "methodId": {
          "type": [
            "string",
            "null"
          ]
        },
        "reqId": {
          "type": "string"
        },
        "type": {
          "const": "provider_auth_start",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reqId",
        "clientRequestId",
        "instanceId"
      ],
      "type": "object"
    },
    {
      "description": "Contains secrets: never log or persist this frame, including goat.jsonl and tracing.",
      "properties": {
        "clientRequestId": {
          "type": "string"
        },
        "flowId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "instanceId": {
          "$ref": "#/$defs/ProviderInstanceId"
        },
        "interactionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "reqId": {
          "type": "string"
        },
        "response": {
          "$ref": "#/$defs/ProviderAuthResponse"
        },
        "type": {
          "const": "provider_auth_respond",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reqId",
        "clientRequestId",
        "instanceId",
        "flowId",
        "interactionId",
        "response"
      ],
      "type": "object"
    },
    {
      "properties": {
        "clientRequestId": {
          "type": "string"
        },
        "flowId": {
          "type": "string"
        },
        "instanceId": {
          "$ref": "#/$defs/ProviderInstanceId"
        },
        "reqId": {
          "type": "string"
        },
        "type": {
          "const": "provider_auth_cancel",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reqId",
        "clientRequestId",
        "instanceId",
        "flowId"
      ],
      "type": "object"
    },
    {
      "properties": {
        "clientRequestId": {
          "type": "string"
        },
        "instanceId": {
          "$ref": "#/$defs/ProviderInstanceId"
        },
        "reqId": {
          "type": "string"
        },
        "type": {
          "const": "provider_auth_logout",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reqId",
        "clientRequestId",
        "instanceId"
      ],
      "type": "object"
    },
    {
      "properties": {
        "clientRequestId": {
          "type": "string"
        },
        "elicitationId": {
          "type": "string"
        },
        "instanceId": {
          "$ref": "#/$defs/ProviderInstanceId"
        },
        "reqId": {
          "type": "string"
        },
        "type": {
          "const": "accept_acp_registry_url_auth",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reqId",
        "clientRequestId",
        "instanceId",
        "elicitationId"
      ],
      "type": "object"
    },
    {
      "properties": {
        "clientRequestId": {
          "type": "string"
        },
        "limit": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "query": {
          "type": "string"
        },
        "reqId": {
          "type": "string"
        },
        "type": {
          "const": "search_acp_registry",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reqId",
        "clientRequestId",
        "query"
      ],
      "type": "object"
    },
    {
      "properties": {
        "agentId": {
          "type": "string"
        },
        "clientRequestId": {
          "type": "string"
        },
        "reqId": {
          "type": "string"
        },
        "type": {
          "const": "prepare_acp_registry_agent",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reqId",
        "clientRequestId",
        "agentId"
      ],
      "type": "object"
    },
    {
      "properties": {
        "acpAgentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "clientRequestId": {
          "type": "string"
        },
        "displayName": {
          "type": [
            "string",
            "null"
          ]
        },
        "driver": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "instanceId": {
          "$ref": "#/$defs/ProviderInstanceId"
        },
        "reqId": {
          "type": "string"
        },
        "type": {
          "const": "set_provider_instance",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reqId",
        "clientRequestId",
        "instanceId",
        "driver",
        "enabled"
      ],
      "type": "object"
    },
    {
      "description": "Start `subscribeCards`. No cursor means \"from the start\".",
      "properties": {
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/CardCursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "subId": {
          "type": "string"
        },
        "type": {
          "const": "subscribe_cards",
          "type": "string"
        }
      },
      "required": [
        "type",
        "subId"
      ],
      "type": "object"
    },
    {
      "description": "Start `subscribeThread`. No cursor means \"from the latest checkpoint\".",
      "properties": {
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/ThreadCursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "subId": {
          "type": "string"
        },
        "threadId": {
          "$ref": "#/$defs/ThreadId"
        },
        "type": {
          "const": "subscribe_thread",
          "type": "string"
        }
      },
      "required": [
        "type",
        "subId",
        "threadId"
      ],
      "type": "object"
    },
    {
      "properties": {
        "subId": {
          "type": "string"
        },
        "type": {
          "const": "unsubscribe",
          "type": "string"
        }
      },
      "required": [
        "type",
        "subId"
      ],
      "type": "object"
    },
    {
      "description": "Older lines for scroll-back: up to `limit` lines with `seq < before`.",
      "properties": {
        "before": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "limit": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "reqId": {
          "type": "string"
        },
        "threadId": {
          "$ref": "#/$defs/ThreadId"
        },
        "type": {
          "const": "read_page",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reqId",
