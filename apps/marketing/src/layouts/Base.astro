---
import dmSansLatinUrl from "../assets/fonts/dm-sans-latin.woff2?url";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { LOCALES, messages, type Locale } from "../i18n";
import { absoluteUrl, localePath, withBase } from "../lib/paths";
import "../styles/fonts.css";
import "../styles/site.css";

interface Props {
  locale: Locale;
  /** Locale-neutral path of this page, such as "/" or "/download/". */
  path: string;
  title: string;
  description: string;
  /** Points search engines at another page that carries the same content. */
  canonicalPath?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const { locale, path, title, description, canonicalPath, noindex = false, jsonLd } = Astro.props;
const t = messages(locale);
const site = Astro.site;
const canonical = absoluteUrl(localePath(locale, canonicalPath ?? path), site);
const ogImage = absoluteUrl(withBase(`og/${locale}.png`), site);
const preview = import.meta.env.MARKETING_NOINDEX === "1";
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fcfcfc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171717" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {(noindex || preview) && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {
      !noindex &&
      LOCALES.map((alternate) => (
        <link
          rel="alternate"
          hreflang={messages(alternate).htmlLang}
          href={absoluteUrl(localePath(alternate, canonicalPath ?? path), site)}
        />
      ))
    }
    {
      !noindex && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={absoluteUrl(localePath("en", canonicalPath ?? path), site)}
        />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GOAT" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.meta.ogAlt} />
    <link rel="preload" href={dmSansLatinUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" href={withBase("favicon.ico")} sizes="32x32" />
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase("apple-touch-icon.png")} />
    <link rel="manifest" href={withBase("site.webmanifest")} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header locale={locale} path={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} path={path} />
  </body>
</html>
