---
// The GOAT mark, from packages/shared/src/goatMark.ts via assets/prod/logo.svg.
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 128 128"
  aria-hidden="true"
  focusable="false"
>
  <rect width="128" height="128" rx="28" fill="#18181b"></rect>
  <g transform="translate(17.24 17.31) scale(3.897)">
    <path
      d="M2.809 13.261 A4.65 4.65 0 0 1 11.1 9.054 L9.397 11.233 A3.45 3.45 0 0 0 2.809 13.261 Z M 21.191 13.261 A 4.65 4.65 0 0 0 12.9 9.054 L 14.603 11.233 A 3.45 3.45 0 0 1 21.191 13.261 Z"
      fill="#fff"
      stroke="#fff"
      stroke-width="0.6"
      stroke-linejoin="round"></path>
    <path
      d="M7.814 16.508 L12 11.15 L16.186 16.508"
      fill="none"
      stroke="#fff"
      stroke-width="2.3"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </g>
</svg>
