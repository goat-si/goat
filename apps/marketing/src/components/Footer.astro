---
import { messages, otherLocale, type Locale } from "../i18n";
import { LINKS } from "../lib/links";
import { localePath } from "../lib/paths";
import Mark from "./Mark.astro";

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const t = messages(locale);
const alternate = otherLocale(locale);
const links = [
  { label: t.footer.links.download, href: localePath(locale, "/download/") },
  { label: t.footer.links.guides, href: LINKS.guides },
  { label: t.footer.links.github, href: LINKS.repository },
  { label: t.footer.links.releases, href: LINKS.releases },
  { label: t.footer.links.legal, href: localePath(locale, "/legal/") },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="footer-brand">
      <Mark size={20} />
      <span>{t.footer.tagline}</span>
    </p>
    <nav aria-label={t.footer.label}>
      <ul class="footer-links">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
        <li>
          <a
            href={localePath(alternate, path)}
            hreflang={messages(alternate).htmlLang}
            lang={messages(alternate).htmlLang}
          >
            {t.switchLabel}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</footer>
