# Pen relay (pen relay serve) as a hardened system service. Install and migration steps:
# docs/operations/pen.md#seoul-relay. /etc/pen-relay.env sets PEN_RELAY_LISTEN (address:443) and
# PEN_RELAY_HOST (the certificate's DNS name), and may set PEN_RELAY_TRAFFIC_NODES (comma-separated
# node ids that get traffic lines; unset logs relay-wide totals only); the ACME cache lives in the
# service's state directory.
[Unit]
Description=Pen relay
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/pen-relay.env
ExecStart=/opt/pen-relay/pen relay serve --listen ${PEN_RELAY_LISTEN} --autocert ${PEN_RELAY_HOST} --cache /var/lib/pen-relay/acme --max-sockets 1024 --max-per-ip 64 --max-queued-mib 128 --max-queued-per-source-mib 16 --traffic-nodes=${PEN_RELAY_TRAFFIC_NODES}
# Memory, what each part may hold at worst (the four flags above and the relay's built-in limits).
# These are not a bound the kernel enforces: GOMEMLIMIT only makes the Go collector work harder near
# it, so the margin under MemoryMax is headroom checked by measurement, not a proof.
# - Go: queued messages at their allocation size, at most 128 MiB (--max-queued-mib; one IPv4
#   address or IPv6 /64 at most 16 MiB); messages being read, up to 108 KiB per connection without a
#   charge (a 96 KiB message and its 4 KiB first buffer; 108 MiB at 1024 connections, --max-sockets)
#   and larger ones from a 32 MiB pool; about 48 KiB per connection of TLS and bufio buffers, timers
#   and goroutine stacks (27 KiB measured idle over 3000 TLS sockets), 48 MiB; about 10 MiB of
#   runtime; what the relay queues without a charge is bounded per connection (the 32-byte
#   challenge once, at most 8 pongs, one close frame: about 1.4 KiB with ring slots; session OPEN
#   and CLOSE frames are charged when a client is admitted), 1.4 MiB at 1024. About 328 MiB live at
#   worst, under GOMEMLIMIT=384MiB with room for the collector.
# - Kernel, outside GOMEMLIMIT but inside MemoryMax under cgroup v2: each connection's send and
#   receive buffers are fixed at 64 KiB (Linux doubles them); a send queue may pass its buffer by
#   about one segment (228 KiB measured per client that stops reading), the receive side stays near
#   130 KiB, so about 360 KiB per connection, 360 MiB at 1024.
# - The binary, slab and other kernel memory: about 32 MiB.
# 384 + 360 + 32 = 776 MiB, with MemoryMax=1G leaving about 250 MiB of headroom. Measured on the
# relay of commit ea4c30d27a (linux x86_64, load about 0.8 on 16 cores, 2026-11-11, these flags,
# TLS, sources on loopback addresses): 400 uplinks with 600 clients from 10 addresses that never
# read, each sent 320 KiB, peaked at 299 MiB (Go 206, kernel sockets 75); 856 uplinks, 64 partly
# sent 1 MiB messages and 96 non-reading clients from 12 addresses filling the queue budget peaked
# at 372 MiB (Go 353); 960 non-reading clients from 64 addresses each sent up to 4 MiB peaked at
# 376 MiB (Go 341, sockets 12); 64 uplinks that never read and 373,495 client sessions opened and
# closed from 8 addresses in 30 s peaked at 26 MiB (Go 17 after). No run reached MemoryMax or was
# refused a connection. Not measured on arm64 (the Seoul VM).
# Change the flags, GOMEMLIMIT and MemoryMax together.
Environment=GOMEMLIMIT=384MiB
DynamicUser=yes
StateDirectory=pen-relay
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# ProcSubset=pid is off: Go reads /proc/sys/net/core/somaxconn for its listen backlog and without
# it falls back to 128, too few when every node reconnects at once after a restart.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
LimitNOFILE=4096
MemoryMax=1G
TasksMax=256
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
