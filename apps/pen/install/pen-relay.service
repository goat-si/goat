# Pen relay (pen relay serve) as a hardened system service. Install and migration steps:
# docs/operations/pen.md#seoul-relay. /etc/pen-relay.env sets PEN_RELAY_LISTEN (address:443) and
# PEN_RELAY_HOST (the certificate's DNS name); the ACME cache lives in the service's state directory.
[Unit]
Description=Pen relay
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/pen-relay.env
ExecStart=/opt/pen-relay/pen relay serve --listen ${PEN_RELAY_LISTEN} --autocert ${PEN_RELAY_HOST} --cache /var/lib/pen-relay/acme --max-queued-mib 192
DynamicUser=yes
StateDirectory=pen-relay
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
LimitNOFILE=65536
# Queued data is capped at 192 MiB (--max-queued-mib); the rest covers up to 4096 sockets' buffers,
# goroutines and in-flight reads, and the Go runtime. Raise both together.
MemoryMax=512M
TasksMax=256
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
